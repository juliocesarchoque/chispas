# Credenciales de tu proyecto Supabase (para sincronización entre teléfono y PC)
# Sin estas variables, Chispa funciona 100% en modo local/offline en este dispositivo.

VITE_SUPABASE_URL=https://tu-proyecto.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=tu-publishable-key
# También puedes usar VITE_SUPABASE_ANON_KEY si tu proyecto usa la clave legacy anon
